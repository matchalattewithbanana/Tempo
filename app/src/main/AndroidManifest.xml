<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification access for tracking music playback -->
    
    <!-- Foreground service for persistent tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Auto-restart after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- Media session access -->
    
    <!-- Wake lock for reliable background operation -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Internet for Spotify and MusicBrainz APIs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only user-approved, GitHub-distributed APK updates. Android still owns installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Desktop Satellite: read WiFi IP to display pairing address -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Desktop Satellite: camera access for scanning desktop QR code -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Query launchable apps instead of all packages -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Required for Android 11+ package visibility when opening https URLs (e.g. Spotify OAuth) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="me.avinas.tempo.TempoApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Tempo"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="tiramisu">

        <!-- Disable default WorkManager initializer to use HiltWorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- MainActivity remains enabled for OAuth, notifications and widget intents.
             Launcher icon variants are aliases so the icon can change without reinstalling. -->
        <activity
            android:name="me.avinas.tempo.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tempo" />
        <activity-alias
            android:name="me.avinas.tempo.launcher.ClassicIcon"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="me.avinas.tempo.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="me.avinas.tempo.launcher.PulseIcon"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="me.avinas.tempo.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_pulse"
            android:roundIcon="@mipmap/ic_launcher_pulse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="me.avinas.tempo.launcher.ClockIcon"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="me.avinas.tempo.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_clock"
            android:roundIcon="@mipmap/ic_launcher_clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="me.avinas.tempo.launcher.TrailIcon"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="me.avinas.tempo.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_trail"
            android:roundIcon="@mipmap/ic_launcher_trail">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="me.avinas.tempo.launcher.VinylIcon"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="me.avinas.tempo.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_vinyl"
            android:roundIcon="@mipmap/ic_launcher_vinyl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Transparent bridge used to choose/persist the automatic local backup folder -->
        <activity
            android:name="me.avinas.tempo.data.drive.LocalBackupFolderPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Music Tracking NotificationListenerService -->
        <service
            android:name="me.avinas.tempo.service.MusicTrackingService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="alerting|ongoing" />
        </service>

        <!-- WorkManager's SystemForegroundService for background workers -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Boot Receiver for auto-restart -->
        <receiver
            android:name="me.avinas.tempo.receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Spotify OAuth Callback Activity -->
        <activity
            android:name="me.avinas.tempo.ui.spotify.SpotifyCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Spotify OAuth redirect URI: tempo://spotify-callback -->
                <data
                    android:scheme="tempo"
                    android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!-- FileProvider for sharing images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget Providers -->
        <receiver
            android:name=".widget.TempoWidgetReceiver"
            android:label="@string/widget_weekly_listening"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TempoArtistWidgetReceiver"
            android:label="@string/widget_artist_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tempo_artist_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TempoDashboardWidgetReceiver"
            android:label="@string/widget_today_listening"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tempo_dashboard_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TempoDiscoveryWidgetReceiver"
            android:label="@string/widget_weekly_discovery"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tempo_discovery_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TempoHeatmapWidgetReceiver"
            android:label="@string/widget_top_genres_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tempo_heatmap_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TempoMilestoneWidgetReceiver"
            android:label="@string/widget_top_song_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tempo_milestone_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TempoMixWidgetReceiver"
            android:label="@string/widget_weekly_daily_time"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tempo_mix_widget_info" />
        </receiver>

        <!-- Service for persisting per-app language on Android 12 and below -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
