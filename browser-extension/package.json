{
  "name": "tempo-stats-extension",
  "version": "4.10.25-beta",
  "description": "Tempo Stats \u2014 Advanced browser music tracking extension",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs --target=chrome",
    "build:firefox": "node build.mjs --target=firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "watch": "node build.mjs --watch",
    "watch:chrome": "node build.mjs --target=chrome --watch",
    "watch:firefox": "node build.mjs --target=firefox --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke-tracker.mjs && node smoke-sync.mjs && node smoke-popup.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
